{
  "manifest_version": 3,
  "name": "Satoshillo",
  "version": "1.4.8",
  "description": "Convierte precios en ARS, USD, EUR y JPY a satoshis.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Satoshillo"
  },
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": [
    "https://api.yadio.io/*",
    "https://api.kraken.com/*",
    "https://open.er-api.com/*",
    "https://api.binance.com/*",
    "https://api.fxratesapi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["price-parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
