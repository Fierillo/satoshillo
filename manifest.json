{
  "manifest_version": 3,
  "name": "Satoshillo",
  "version": "1.4.3",
  "description": "Convierte precios en ARS, USD, EUR y JPY a satoshis.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Satoshillo"
  },
  "permissions": ["storage", "alarms", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.coingecko.com/*",
    "https://api.yadio.io/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["price-parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
